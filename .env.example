# Database
BF6_DB_PATH=./data/bf6.db

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=OpenBF6Tracker

# Suspicion system
SUSPICION_HMAC_SECRET=change-me-in-production
SUSPICION_COOKIE_NAME=bf6_reporter

# Admin
ADMIN_PASSWORD=admin123
JWT_SECRET=change-me-to-a-random-string

# Background poller
BF6_POLL_INTERVAL_SECONDS=300

# EA official gRPC
# 可选：覆盖内置的 GLACIER_PC_CLIENT secret（后台「EA 账号」里填写会优先生效）
# EA_GLACIER_CLIENT_SECRET=

# 可选：账号凭证加密密钥文件所在目录（默认跟 BF6_DB_PATH 同目录，文件名 ea-vault.key）
# 首次启动会自动生成，切勿丢失，否则已保存的 sid/remid/token 全部无法解密。
# EA_VAULT_DIR=
